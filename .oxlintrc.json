{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "nextjs"],
  "jsPlugins": ["./lint/plugin.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "react": {
      "version": "19.3.1"
    }
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/.cache/**",
    "**/.wrangler/**",
    "**/public/**",
    "next-env.d.ts",
    "pnpm-lock.yaml"
  ],
  "rules": {
    "typescript/consistent-type-imports": [
      "warn",
      { "fixStyle": "inline-type-imports", "disallowTypeAnnotations": false }
    ],
    "sort-imports": [
      "warn",
      { "ignoreCase": true, "ignoreDeclarationSort": true }
    ],
    "no-unused-vars": ["error", { "args": "all", "argsIgnorePattern": "^_" }],
    "typescript/no-unused-vars": [
      "error",
      { "args": "all", "argsIgnorePattern": "^_" }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/unbound-method": "off",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-boolean-literal-compare": "warn",
    "typescript/no-unnecessary-type-parameters": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/restrict-template-expressions": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-useless-default-assignment": "warn",
    "typescript/require-array-sort-compare": "warn",
    "typescript/no-misused-spread": "warn",
    "typescript/no-base-to-string": "warn",
    "typescript/no-duplicate-type-constituents": "warn",
    "typescript/array-type": ["warn", { "default": "array" }],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "no-shadow": "off",
    "no-new": "off",
    "no-underscore-dangle": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../**"],
            "message": "Import from another folder through @/ instead."
          }
        ]
      }
    ],
    "react/exhaustive-deps": "warn",
    "react/memo-dependencies": "warn",
    "react/rules-of-hooks": "warn",
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "off",
    "react/no-danger": "off",
    "react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "react/set-state-in-render": "warn",
    "react/immutability": "warn",
    "react/incompatible-library": "warn",
    "react/purity": "warn",
    "react/preserve-manual-memoization": "warn",
    "react/use-memo": "warn",
    "react/static-components": "warn",
    "nextjs/no-img-element": "warn",
    "nextjs/no-html-link-for-pages": "warn",
    "nextjs/no-assign-module-variable": "warn",
    "import/no-named-as-default": "warn",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "unicorn/no-new-array": "warn",
    "unicorn/no-invalid-remove-event-listener": "warn",
    "unicorn/no-array-sort": "off",
    "unicorn/catch-error-name": ["warn", { "name": "error" }],
    "unicorn/require-post-message-target-origin": "off",
    "wadsmith/top-down-order": "warn",
    "wadsmith/comment-style": "error",
    "wadsmith/no-low-value-comments": "error",
    "wadsmith/no-inline-props": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{test,spec}.{ts,tsx}"],
      "env": {
        "vitest": true
      },
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "react/refs": "off",
        "react/immutability": "off"
      }
    }
  ]
}
