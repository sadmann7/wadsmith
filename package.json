{
  "name": "wadsmith",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev",
    "dev:rooms": "wrangler dev --config rooms/wrangler.jsonc",
    "dev:coop": "concurrently -n next,rooms \"next dev\" \"pnpm dev:rooms\"",
    "build": "next build",
    "start": "next start",
    "setup:engine": "node scripts/setup-engine.mjs",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p rooms",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@ui-sdk/core": "0.1.0-beta.14",
    "@ui-sdk/react": "0.1.0-beta.14",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  }
}
