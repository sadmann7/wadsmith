+// Fills wadsmith_monsters with the live monsters within range of the player,
+// as x, y and angle in degrees, and returns how many there are.
+EXPORT int wadsmith_monsters_near(int range)
+{
+    const mobj_t *player = Player()->mo;
+    if (gamestate != GS_LEVEL || player == NULL)
+    {
+        return 0;
+    }
+    const thinker_t *cap = &thinkerclasscap[th_enemies];
+    int count = 0;
+    for (const thinker_t *th = cap->cnext; th != cap && count < MAX_MONSTERS;
+         th = th->cnext)
+    {
+        const mobj_t *mo = (const mobj_t *)th;
+        const int x = mo->x >> FRACBITS;
+        const int y = mo->y >> FRACBITS;
+        const int dx = x - (player->x >> FRACBITS);
+        const int dy = y - (player->y >> FRACBITS);
+        if (mo->health <= 0 || dx < -range || dx > range || dy < -range
+            || dy > range)
+        {
+            continue;
+        }
+        int *at = monsters + count * MONSTER_FIELDS;
+        at[0] = x;
+        at[1] = y;
+        at[2] = (int)(((unsigned long long)mo->angle * 360) >> 32);
+        count++;
+    }
+    return count;
+}
