diff --git a/src/wadsmith.c b/src/wadsmith.c
new file mode 100644
index 0000000..8a5734c
--- /dev/null
+++ b/src/wadsmith.c
@@ -0,0 +1,488 @@
+// The interface between Woof and Wadsmith's game worker.
+
+#include <emscripten.h>
+#include <limits.h>
+
+#include "d_event.h"
+#include "d_items.h"
+#include "d_main.h"
+#include "d_player.h"
+#include "deh_misc.h"
+#include "doomstat.h"
+#include "g_game.h"
+#include "i_video.h"
+#include "m_config.h"
+#include "m_fixed.h"
+#include "p_mobj.h"
+#include "p_tick.h"
+#include "r_defs.h"
+#include "r_state.h"
+#include "v_video.h"
+#include "wadsmith.h"
+
+#define EXPORT EMSCRIPTEN_KEEPALIVE
+
+extern boolean sendpause;
+
+static uint8_t palette[256 * 3];
+static uint8_t *rgba;
+static int rgba_size;
+static int frames;
+static float mouse_turn;
+static int wanted_cheats;
+
+void WADSMITH_Exit(int code)
+{
+    EM_ASM({ throw { wadsmithExit: $0 }; }, code);
+}
+
+void WADSMITH_FramePresented(void)
+{
+    frames++;
+}
+
+void WADSMITH_SetPalette(const SDL_Color *colors)
+{
+    for (int i = 0; i < 256; i++)
+    {
+        palette[i * 3] = colors[i].r;
+        palette[i * 3 + 1] = colors[i].g;
+        palette[i * 3 + 2] = colors[i].b;
+    }
+}
+
+float WADSMITH_TakeMouseTurn(void)
+{
+    const float turn = mouse_turn;
+    mouse_turn = 0.0f;
+    return turn;
+}
+
+static player_t *Player(void)
+{
+    return &players[consoleplayer];
+}
+
+#define TRAIL_FIELDS 6
+#define TRAIL_EVENTS 8192
+// A player's place is recorded this often, in tics, while they move.
+#define TRAIL_STEP_TICS 4
+
+static int trail[TRAIL_EVENTS * TRAIL_FIELDS];
+static int trail_count;
+static int trail_x[MAXPLAYERS], trail_y[MAXPLAYERS];
+static boolean trail_placed[MAXPLAYERS];
+
+// Events past a full buffer are dropped. The page empties it many times a
+// second, so that takes a page that stopped listening.
+static void Trail(int kind, int player, int x, int y, int value)
+{
+    if (trail_count == TRAIL_EVENTS)
+    {
+        return;
+    }
+
+    int *event = trail + trail_count++ * TRAIL_FIELDS;
+    event[0] = leveltime;
+    event[1] = kind;
+    event[2] = player;
+    event[3] = x;
+    event[4] = y;
+    event[5] = value;
+}
+
+void WADSMITH_TrailStart(void)
+{
+    for (int i = 0; i < MAXPLAYERS; i++)
+    {
+        trail_placed[i] = false;
+    }
+
+    Trail(WADSMITH_TRAIL_START, -1, gameepisode, gamemap, gameskill);
+}
+
+void WADSMITH_TrailTick(void)
+{
+    if (leveltime % TRAIL_STEP_TICS)
+    {
+        return;
+    }
+
+    for (int i = 0; i < MAXPLAYERS; i++)
+    {
+        const mobj_t *mo = playeringame[i] ? players[i].mo : NULL;
+
+        if (!mo)
+        {
+            continue;
+        }
+
+        const int x = mo->x >> FRACBITS, y = mo->y >> FRACBITS;
+
+        if (trail_placed[i] && x == trail_x[i] && y == trail_y[i])
+        {
+            continue;
+        }
+
+        trail_placed[i] = true;
+        trail_x[i] = x;
+        trail_y[i] = y;
+        Trail(WADSMITH_TRAIL_STEP, i, x, y, players[i].health);
+    }
+}
+
+void WADSMITH_TrailEvent(int kind, const mobj_t *mo, int value)
+{
+    if (mo && mo->player)
+    {
+        Trail(kind, mo->player - players, mo->x >> FRACBITS,
+              mo->y >> FRACBITS, value);
+    }
+}
+
+// A death's value says what killed the player: a thing's editor number, -1
+// for a player, their own shot included, and 0 for the level itself.
+void WADSMITH_TrailDeath(const mobj_t *mo, const mobj_t *killer)
+{
+    int value = 0;
+
+    if (killer && killer->player)
+    {
+        value = -1;
+    }
+    else if (killer && killer->info->doomednum > 0)
+    {
+        value = killer->info->doomednum;
+    }
+
+    WADSMITH_TrailEvent(WADSMITH_TRAIL_DEATH, mo, value);
+}
+
+void WADSMITH_TrailExit(void)
+{
+    Trail(WADSMITH_TRAIL_TOTALS, -1, totalkills, totalsecret, totalitems);
+
+    for (int i = 0; i < MAXPLAYERS; i++)
+    {
+        if (playeringame[i])
+        {
+            Trail(WADSMITH_TRAIL_EXIT, i, players[i].killcount,
+                  players[i].secretcount, players[i].itemcount);
+        }
+    }
+}
