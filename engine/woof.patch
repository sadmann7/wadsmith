+boolean I_OAL_InitStream(void)
+{
+    music.gain = 1.0f;
+    music.initialized = true;
+    return true;
+}
+void I_OAL_ShutdownStream(void) { music.initialized = false; }
+
+static boolean Music_Init(int device) { return stream_opl_module.I_InitStream(device); }
+static void Music_Stop(void *handle) { (void)handle; music.playing = false; }
+static void Music_Unregister(void *handle)
+{
+    (void)handle;
+    if (music.loaded)
+    {
+        stream_opl_module.I_CloseStream();
+        music.loaded = false;
+    }
+}
+static void Music_Shutdown(void)
+{
+    Music_Stop(NULL);
+    Music_Unregister(NULL);
+    stream_opl_module.I_ShutdownStream();
+}
+static void Music_SetVolume(int volume) { music.gain = volume / 15.0f; }
+static void Music_Pause(void *handle) { (void)handle; music.paused = true; }
+static void Music_Resume(void *handle) { (void)handle; music.paused = false; }
+static void *Music_Register(void *data, int size)
+{
+    ALenum format;
+    ALsizei freq, frame_size;
+    if (!music.initialized || !stream_opl_module.I_OpenStream(data, size, &format, &freq, &frame_size))
+    {
+        return NULL;
+    }
+    music.loaded = true;
+    return &music;
+}
+static void Music_Play(void *handle, boolean looping)
+{
+    (void)handle;
+    stream_opl_module.I_PlayStream(looping);
+    music.frames = 0;
+    music.pos = 0.0;
+    music.playing = true;
+}
