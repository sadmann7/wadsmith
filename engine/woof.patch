+static void Native_Shutdown(void) {}
+static void Native_Volume(int volume) { (void)volume; }
+static void Native_Handle(void *handle) { (void)handle; }
+static void *Native_Register(void *data, int size) { (void)data; (void)size; return NULL; }
+static void Native_Play(void *handle, boolean looping) { (void)handle; (void)looping; }
+static const char **Native_Devices(void) { return NULL; }
+static void Native_Bind(void) { MIDISeq_BindVariables(); MIDIDevice_BindVariables(); }
+static const char *Native_Format(void) { return "None"; }
+
