+boolean I_OAL_SoundIsPlaying(int channel) { return channels[channel].active && !channels[channel].paused; }
+boolean I_OAL_SoundIsPaused(int channel) { return channels[channel].active && channels[channel].paused; }
+void I_OAL_SetGain(int channel, float gain) { channels[channel].gain = gain; }
+void I_OAL_SetVolume(int channel, int volume) { channels[channel].gain = volume / 127.0f; }
+void I_OAL_SetPan(int channel, int separation) { channels[channel].pan = separation / 255.0f - 0.5f; }
+
+void WADSMITH_BindUnusedVariables(void);
+void I_OAL_BindSoundVariables(void) { WADSMITH_BindUnusedVariables(); }
+
+static struct
+{
+    boolean initialized, loaded, playing, paused;
+    float gain;
+    short buffer[(MUSIC_CHUNK + 1) * 2];
+    int frames;
+    double pos;
+} music;
