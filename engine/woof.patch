@@ -0,0 +1,133 @@
+// Features the browser build leaves out, kept as settings because the options
+// menu looks them up by name when it starts.
+
+#include <SDL3/SDL.h>
+
+#include "doomtype.h"
+#include "i_endoom.h"
+#include "i_rumble.h"
+#include "m_array.h"
+#include "m_config.h"
+#include "nw_defs.h"
+#include "nw_sdl.h"
+
+static const char *const unused_numbers[] = {
+    "fl_chorus_depth",
+    "fl_chorus_level",
+    "fl_chorus_nr",
+    "fl_chorus_speed",
+    "fl_gain",
+    "fl_note_cut",
+    "fl_polyphony",
+    "fl_reverb_damp",
+    "fl_reverb_level",
+    "fl_reverb_roomsize",
+    "fl_reverb_width",
+    "joy_rumble",
+    "midi_gain",
+    "opl_gain",
+    "snd_absorption",
+    "snd_doppler",
+    "snd_eq_high_cutoff",
+    "snd_eq_high_gain",
+    "snd_eq_low_cutoff",
+    "snd_eq_low_gain",
+    "snd_eq_mid1_center",
+    "snd_eq_mid1_gain",
+    "snd_eq_mid1_width",
+    "snd_eq_mid2_center",
+    "snd_eq_mid2_gain",
+    "snd_eq_mid2_width",
+    "snd_eq_preamp",
+    "snd_equalizer",
+    "snd_resampler",
+};
+static const char *const unused_flags[] = {
+    "auto_gain",
+    "fl_chorus",
+    "fl_interpolation",
+    "fl_reverb",
+    "snd_hrtf",
+};
+static const char *const unused_strings[] = {
+    "soundfont_dirs",
+};
+
+void WADSMITH_BindUnusedVariables(void)
+{
+    static boolean bound;
+    static int numbers[arrlen(unused_numbers)];
+    static boolean flags[arrlen(unused_flags)];
+    static const char *strings[arrlen(unused_strings)];
+
+    if (bound)
+    {
+        return;
+    }
+    bound = true;
+
+    for (int i = 0; i < arrlen(unused_numbers); i++)
+    {
+        M_BindNum(unused_numbers[i], &numbers[i], NULL, 0, -1000000, 1000000,
+                  wad_no, "");
+    }
+    for (int i = 0; i < arrlen(unused_flags); i++)
+    {
+        M_BindBool(unused_flags[i], &flags[i], NULL, false, wad_no, "");
+    }
+    for (int i = 0; i < arrlen(unused_strings); i++)
+    {
+        M_BindStr((char *)unused_strings[i], &strings[i], "", wad_no, "");
+    }
+}
+
+void I_BindEqualizerVariables(void) { WADSMITH_BindUnusedVariables(); }
+void I_OAL_EqualizerPreset(void) {}
+void I_OAL_SetEqualizer(void) {}
+boolean I_OAL_EqualizerInitialized(void) { return false; }
+boolean I_OAL_CustomEqualizer(void) { return false; }
+
+void I_ShutdownRumble(void) {}
+void I_InitRumble(void) {}
+void I_CacheRumble(struct sfxinfo_s *sfx, int format, const byte *data,
+                   int size, int rate) {}
+boolean I_RumbleEnabled(void) { return false; }
+boolean I_RumbleSupported(void) { return false; }
+void I_RumbleMenuFeedback(void) {}
+void I_UpdateRumbleEnabled(void) {}
+void I_SetRumbleSupported(SDL_Gamepad *gamepad) {}
+void I_ResetRumbleChannel(int handle) {}
+void I_ResetAllRumbleChannels(void) {}
+void I_UpdateRumble(void) {}
+void I_UpdateRumbleParams(const struct mobj_s *listener,
+                          const struct mobj_s *origin, int handle) {}
+void I_StartRumble(const struct mobj_s *listener, const struct mobj_s *origin,
+                   const struct sfxinfo_s *sfx, int handle,
+                   rumble_type_t type) {}
+void I_DisableRumble(void) {}
+void I_BindRumbleVariables(void) { WADSMITH_BindUnusedVariables(); }
+
+void I_Endoom(byte *data) {}
+
+// Server search is LAN and master-server discovery, which a browser can't do.
+static boolean NoQueryInit(void) { return false; }
+static void NoQuerySend(nw_addr_t *addr, nw_packet_t *packet) {}
+static boolean NoQueryReceive(nw_addr_t **addr, nw_packet_t **packet)
+{
+    return false;
+}
+static void NoQueryName(nw_addr_t *addr, char *buffer, int length)
+{
+    buffer[0] = '\0';
+}
+static void NoQueryFree(nw_addr_t *addr) {}
+static nw_addr_t *NoQueryResolve(const char *address) { return NULL; }
+static void NoQueryShutdown(void) {}
+
+nw_module_t nw_sdl_query_module = {
+    NoQueryInit,    NoQueryInit, NoQuerySend,
+    NoQueryReceive, NoQueryName, NoQueryFree,
+    NoQueryResolve, NoQueryShutdown,
+};
+
+void NW_ResetSocket(void) {}
