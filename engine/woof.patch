+    {
+        array_push(strings, "Linear");
+    }
+    return strings;
+}
+
+boolean I_OAL_CacheSound(sfxinfo_t *sfx)
+{
+    if (sfx->cached)
+    {
+        return true;
+    }
+    const int lumpnum = I_GetSfxLumpNum(sfx);
+    if (lumpnum < 0)
+    {
+        return false;
+    }
+    byte *lump = W_CacheLumpNum(lumpnum, PU_STATIC);
+    const int len = W_LumpLength(lumpnum);
+    boolean ok = false;
+    if (len > DMXHDRSIZE && lump[0] == 0x03 && lump[1] == 0x00)
+    {
+        const int freq = (lump[3] << 8) | lump[2];
+        int size = (lump[7] << 24) | (lump[6] << 16) | (lump[5] << 8) | lump[4];
+        if (size <= len - DMXHDRSIZE && size > DMXPADSIZE * 2 && freq > 0)
+        {
+            size -= DMXPADSIZE * 2;
+            web_sfx_t entry = {malloc(size), size, freq};
+            memcpy(entry.data, lump + DMXHDRSIZE + DMXPADSIZE, size);
+            if (!sfx->looping)
+            {
+                FadeInOutMono8(entry.data, size, freq);
+            }
+            array_push(sfx_table, entry);
+            sfx->buffer = array_size(sfx_table);
+            sfx->cached = true;
+            if (sfx->flags & SFX_Ambient)
+            {
+                sfx->length = (float)size / freq;
+            }
+            ok = true;
+        }
+    }
+    Z_Free(lump);
+    if (!ok)
+    {
+        sfx->lumpnum = -2;
+    }
+    return ok;
+}
+
+float I_OAL_GetOffset(int channel)
+{
+    const web_channel_t *c = &channels[channel];
+    return c->active && c->sfx ? (float)(c->pos / c->sfx->rate) : 0.0f;
+}
+
+boolean I_OAL_StartSound(int channel, sfxinfo_t *sfx, const sfxparams_t *params)
+{
+    if (!sfx->buffer)
+    {
+        return false;
+    }
+    web_channel_t *c = &channels[channel];
+    c->sfx = &sfx_table[sfx->buffer - 1];
+    c->pos = params->offset * c->sfx->rate;
+    c->step = (double)c->sfx->rate * params->pitch / output_rate;
+    c->looping = sfx->looping;
+    c->active = true;
+    c->paused = false;
+    c->fresh = true;
+    return true;
+}
+void I_OAL_StopSound(int channel) { channels[channel].active = false; channels[channel].paused = false; }
+void I_OAL_PauseSound(int channel) { if (channels[channel].active) channels[channel].paused = true; }
+void I_OAL_ResumeSound(int channel) { channels[channel].paused = false; }
