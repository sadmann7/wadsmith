+    Native_Init, Native_Shutdown, Native_Volume, Native_Handle, Native_Handle, Native_Register,
+    Native_Play, Native_Handle, Native_Handle, Native_Devices, Native_Bind, Native_Format,
+};
+
+static void MixMusic(int frames)
+{
+    if (!music.playing || music.paused)
+    {
+        return;
+    }
+    const double step = (double)OPL_SAMPLE_RATE / output_rate;
+    for (int i = 0; i < frames; i++)
+    {
+        int index = (int)music.pos;
+        while (index + 1 >= music.frames)
+        {
+            int keep = 0;
+            if (music.frames > 0)
+            {
+                music.buffer[0] = music.buffer[(music.frames - 1) * 2];
+                music.buffer[1] = music.buffer[(music.frames - 1) * 2 + 1];
+                music.pos -= music.frames - 1;
+                keep = 1;
+            }
+            const int got = stream_opl_module.I_FillStream(music.buffer + keep * 2, MUSIC_CHUNK);
+            if (got <= 0)
+            {
+                music.playing = false;
+                return;
+            }
+            music.frames = got + keep;
+            index = (int)music.pos;
+        }
+        const float f = (float)(music.pos - index);
+        const short *a = &music.buffer[index * 2];
+        out_left[i] += MUSIC_LEVEL * music.gain * (a[0] + (a[2] - a[0]) * f) / 32768.0f;
+        out_right[i] += MUSIC_LEVEL * music.gain * (a[1] + (a[3] - a[1]) * f) / 32768.0f;
+        music.pos += step;
+    }
+}
+
+static void MixChannel(web_channel_t *c, int frames)
+{
+    const float theta = (c->pan + 0.5f) * (float)M_PI_2;
+    const float left_target = SFX_LEVEL * c->gain * cosf(theta), right_target = SFX_LEVEL * c->gain * sinf(theta);
+    if (c->fresh)
+    {
+        c->left = left_target;
+        c->right = right_target;
+        c->fresh = false;
+    }
+    const float left_step = (left_target - c->left) / frames, right_step = (right_target - c->right) / frames;
+    const byte *data = c->sfx->data;
+    const int total = c->sfx->frames;
+    for (int i = 0; i < frames; i++)
+    {
+        int index = (int)c->pos;
+        if (index >= total)
+        {
+            if (!c->looping)
+            {
+                c->active = false;
+                return;
+            }
+            c->pos -= total;
+            index = (int)c->pos;
+        }
+        const int next = index + 1 < total ? index + 1 : (c->looping ? 0 : index);
+        const float f = (float)(c->pos - index);
+        const float sample = ((data[index] + (data[next] - data[index]) * f) - 128.0f) / 128.0f;
+        c->left += left_step;
+        c->right += right_step;
+        out_left[i] += sample * c->left;
+        out_right[i] += sample * c->right;
+        c->pos += c->step;
+    }
+}
+
+// A look-ahead limiter: the gain is already down by the time a peak arrives, so
+// stacked sounds get quieter instead of clipping.
+static struct
+{
+    int length;
+    float release;
+    float delay[LIMITER_MAX_FRAMES][2];
+    float wanted[LIMITER_MAX_FRAMES];
+    float smooth[LIMITER_MAX_FRAMES];
+    float held, sum;
+    int position;
+} limiter;
+
+static void ResetLimiter(void)
+{
+    int length = output_rate * LIMITER_LOOKAHEAD_MS / 1000;
+    if (length > LIMITER_MAX_FRAMES)
+    {
+        length = LIMITER_MAX_FRAMES;
+    }
+    limiter.length = length;
+    limiter.release = 1.0f / (output_rate * LIMITER_RELEASE_MS / 1000.0f);
+    limiter.held = 1.0f;
+    limiter.sum = (float)length;
+    limiter.position = 0;
+    for (int i = 0; i < length; i++)
+    {
+        limiter.wanted[i] = limiter.smooth[i] = 1.0f;
+        limiter.delay[i][0] = limiter.delay[i][1] = 0.0f;
+    }
+}
+
+static void Limit(float *left, float *right)
+{
+    const int at = limiter.position, length = limiter.length;
+    const float peak = fmaxf(fabsf(*left), fabsf(*right));
+    limiter.wanted[at] = peak > LIMITER_CEILING ? LIMITER_CEILING / peak : 1.0f;
+
+    float lowest = limiter.wanted[at];
+    for (int i = 0; i < length; i++)
+    {
+        lowest = fminf(lowest, limiter.wanted[i]);
+    }
+    limiter.held = fminf(lowest, fminf(1.0f, limiter.held + limiter.release));
+
+    limiter.sum += limiter.held - limiter.smooth[at];
+    limiter.smooth[at] = limiter.held;
+    const float gain = limiter.sum / length;
+
+    const float out_l = limiter.delay[at][0], out_r = limiter.delay[at][1];
+    limiter.delay[at][0] = *left;
+    limiter.delay[at][1] = *right;
+    limiter.position = (at + 1) % length;
+    *left = out_l * gain;
+    *right = out_r * gain;
+}
+
+EMSCRIPTEN_KEEPALIVE void wadsmith_audio_init(int rate)
+{
+    output_rate = rate;
+    ResetLimiter();
+}
+
+EMSCRIPTEN_KEEPALIVE float *wadsmith_audio_render(int frames)
+{
+    if (frames > MAX_BLOCK)
+    {
+        frames = MAX_BLOCK;
+    }
+    memset(out_left, 0, sizeof(float) * frames);
+    memset(out_right, 0, sizeof(float) * frames);
+    MixMusic(frames);
+    if (!sfx_muted)
+    {
+        for (int c = 0; c < MAX_CHANNELS; c++)
+        {
+            if (channels[c].active && !channels[c].paused)
+            {
+                MixChannel(&channels[c], frames);
+            }
+        }
+    }
+    const float jump_left = last_left - out_left[0];
+    const float jump_right = last_right - out_right[0];
+    if (fabsf(jump_left) > 0.02f || fabsf(jump_right) > 0.02f)
+    {
+        const int span = frames < 64 ? frames : 64;
+        for (int i = 0; i < span; i++)
+        {
+            const float fade = 1.0f - (float)i / span;
+            out_left[i] += jump_left * fade;
+            out_right[i] += jump_right * fade;
+        }
+    }
+    last_left = out_left[frames - 1];
+    last_right = out_right[frames - 1];
+    const float ramp = 1.0f / GAIN_RAMP_FRAMES;
+    for (int i = 0; i < frames; i++)
+    {
+        if (master_gain < master_target)
+        {
+            master_gain = fminf(master_target, master_gain + ramp);
+        }
+        else if (master_gain > master_target)
+        {
+            master_gain = fmaxf(master_target, master_gain - ramp);
+        }
+        float l = out_left[i] * master_gain, r = out_right[i] * master_gain;
+        Limit(&l, &r);
+        out_interleaved[i * 2] = l;
+        out_interleaved[i * 2 + 1] = r;
+    }
+    return out_interleaved;
+}
+
+EMSCRIPTEN_KEEPALIVE void wadsmith_set_sound(int volume, int muted)
+{
+    S_SetSfxVolume(volume);
+    S_SetMusicVolume(volume);
+    master_target = muted ? 0.0f : 1.0f;
+}
diff --git a/src/wadsmith_net.c b/src/wadsmith_net.c
new file mode 100644
index 0000000..a1f7791
--- /dev/null
+++ b/src/wadsmith_net.c
@@ -0,0 +1,258 @@
+// Woof's network module for the browser. Packets come in through memory the
+// page shares with this worker, so Woof's own loops that wait for replies keep
+// working. An address is the number the room gives each player.
+
+#include <emscripten.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "d_player.h"
+#include "doomstat.h"
+#include "doomtype.h"
+#include "m_fixed.h"
+#include "nw_client.h"
+#include "nw_defs.h"
+#include "nw_io.h"
+#include "nw_packet.h"
+#include "nw_sdl.h"
+#include "nw_server.h"
+#include "p_mobj.h"
+
+#define EXPORT EMSCRIPTEN_KEEPALIVE
+
+#define MAX_PEERS 16
+#define MAX_PACKET 16384
+
+static nw_addr_t addrs[MAX_PEERS];
+static uint32_t peers[MAX_PEERS];
+static int num_addrs;
+
+static uint8_t incoming[MAX_PACKET];
+
+static nw_addr_t *AddressOf(uint32_t peer)
+{
+    for (int i = 0; i < num_addrs; i++)
+    {
+        if (peers[i] == peer)
+        {
+            return &addrs[i];
+        }
+    }
+
+    if (peer == 0 || num_addrs == MAX_PEERS)
+    {
+        return NULL;
+    }
+
+    nw_addr_t *addr = &addrs[num_addrs];
+    peers[num_addrs] = peer;
+    addr->module = &nw_sdl_module;
+    addr->refcount = 0;
+    addr->handle = &peers[num_addrs];
+    num_addrs++;
+    return addr;
+}
+
+static boolean InitModule(void)
+{
+    return EM_ASM_INT({ return Module.wadsmithNet ? 1 : 0; });
+}
+
+static void SendPacket(nw_addr_t *addr, nw_packet_t *packet)
+{
+    EM_ASM({ Module.wadsmithNet.send($0 >>> 0, HEAPU8.slice($1, $1 + $2)); },
+           *(uint32_t *)addr->handle, packet->data, (int)packet->len);
+}
+
+// The page only writes a packet that fits, and returns -1 when none is left.
+static boolean RecvPacket(nw_addr_t **addr, nw_packet_t **packet)
+{
+    uint32_t peer;
+
+    for (;;)
+    {
+        const int length = EM_ASM_INT(
+            { return Module.wadsmithNet.receive($0, $1, $2); }, incoming,
+            MAX_PACKET, &peer);
+
+        if (length <= 0 || length > MAX_PACKET)
+        {
+            return false;
+        }
+
+        nw_addr_t *from = AddressOf(peer);
+
+        if (from == NULL)
+        {
+            continue;
+        }
+
+        nw_packet_t *result = NW_NewPacket(length);
+        memcpy(result->data, incoming, length);
+        result->len = length;
+
+        NW_ReferenceAddress(from);
+        *addr = from;
+        *packet = result;
+        return true;
+    }
+}
+
+static void AddrToString(nw_addr_t *addr, char *buffer, int buffer_len)
+{
+    snprintf(buffer, buffer_len, "player %u", *(uint32_t *)addr->handle);
+}
+
+// Addresses last for the whole session.
+static void FreeAddress(nw_addr_t *addr) {}
+
+static nw_addr_t *ResolveAddress(const char *address)
+{
+    char *end;
+    const unsigned long peer = address ? strtoul(address, &end, 10) : 0;
+
+    if (address == NULL || *end != '\0' || peer > UINT32_MAX)
+    {
+        return NULL;
+    }
+
+    return AddressOf((uint32_t)peer);
+}
+
+static void Shutdown(void) {}
+
+nw_module_t nw_sdl_module = {
+    InitModule,   InitModule,  SendPacket,     RecvPacket,
+    AddrToString, FreeAddress, ResolveAddress, Shutdown,
+};
+
+// Only the host, which controls the game, can start it for everyone.
+EXPORT int wadsmith_net_launch(void)
+{
+    if (!nw_client_connected || !nw_client_received_wait_data
+        || !nw_client_wait_data.is_controller)
+    {
+        return 0;
+    }
+
+    NW_CL_LaunchGame();
+    return 1;
+}
+
+EXPORT int wadsmith_net_connected(void)
+{
+    return nw_client_connected;
+}
+
+EXPORT int wadsmith_net_waiting_players(void)
+{
+    return nw_client_connected && nw_client_received_wait_data
+               ? nw_client_wait_data.num_players
+               : 0;
+}
+
+EXPORT int wadsmith_players_in_game(void)
+{
+    int count = 0;
+
+    for (int i = 0; i < MAXPLAYERS; i++)
+    {
+        count += playeringame[i] ? 1 : 0;
+    }
+
+    return count;
+}
+
+EXPORT int wadsmith_console_player(void)
+{
+    return consoleplayer;
+}
+
+static const mobj_t *PlayerMobj(int player)
+{
+    return player >= 0 && player < MAXPLAYERS && playeringame[player]
+               ? players[player].mo
+               : NULL;
+}
+
+EXPORT int wadsmith_net_player_x(int player)
+{
+    const mobj_t *mo = PlayerMobj(player);
+    return mo ? mo->x >> FRACBITS : 0;
+}
+
+EXPORT int wadsmith_net_player_y(int player)
+{
+    const mobj_t *mo = PlayerMobj(player);
+    return mo ? mo->y >> FRACBITS : 0;
+}
+
+static const player_t *NetPlayer(int player)
+{
+    return player >= 0 && player < MAXPLAYERS && playeringame[player]
+               ? &players[player]
+               : NULL;
+}
+
+// Each engine joins under its room peer number as its player name, which ties
+// a game slot to a room player.
+EXPORT int wadsmith_net_player_peer(int player)
+{
+    if (NetPlayer(player) == NULL || !nw_client_received_wait_data
+        || player >= nw_client_wait_data.num_players)
+    {
+        return 0;
+    }
+
+    return atoi(nw_client_wait_data.player_names[player]);
+}
+
+EXPORT int wadsmith_net_player_frags(int player)
+{
+    const player_t *p = NetPlayer(player);
+    int frags = 0;
+
+    for (int i = 0; p && i < MAXPLAYERS; i++)
+    {
+        frags += i == player ? -p->frags[i] : p->frags[i];
+    }
+
+    return frags;
+}
+
+EXPORT int wadsmith_net_player_deaths(int player)
+{
+    int deaths = 0;
+
+    for (int i = 0; NetPlayer(player) && i < MAXPLAYERS; i++)
+    {
+        deaths += players[i].frags[player];
+    }
+
+    return deaths;
+}
+
+EXPORT int wadsmith_net_player_kills(int player)
+{
+    const player_t *p = NetPlayer(player);
+    return p ? p->killcount : 0;
+}
+
+EXPORT int wadsmith_net_player_items(int player)
+{
+    const player_t *p = NetPlayer(player);
+    return p ? p->itemcount : 0;
+}
+
+EXPORT int wadsmith_net_player_secrets(int player)
+{
+    const player_t *p = NetPlayer(player);
+    return p ? p->secretcount : 0;
+}
+
+EXPORT int wadsmith_net_lagging_players(void)
+{
+    return NW_SV_LaggingPlayers();
+}
diff --git a/src/wadsmith_unused.c b/src/wadsmith_unused.c
