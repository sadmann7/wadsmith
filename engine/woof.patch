+void I_OAL_SetResampler(void) {}
+void I_OAL_ResetSource2D(int channel) { (void)channel; }
+void I_OAL_ResetSource3D(int channel, boolean point_source, const sfxparams_t *params)
+{
+    (void)channel; (void)point_source; (void)params;
+}
