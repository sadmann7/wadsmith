+#include "z_zone.h"
+
+#define DMXHDRSIZE 8
+#define DMXPADSIZE 16
+#define FADETIME 1000
+#define MAX_BLOCK 8192
+#define MUSIC_CHUNK 2048
+#define GAIN_RAMP_FRAMES 256
+
+typedef struct
+{
+    byte *data;
+    int frames;
+    int rate;
+} web_sfx_t;
+
+typedef struct
+{
+    const web_sfx_t *sfx;
+    double pos, step;
+    float gain, pan, left, right;
+    boolean active, paused, looping, fresh;
+} web_channel_t;
+
+static web_sfx_t *sfx_table;
+static web_channel_t channels[MAX_CHANNELS];
+static int output_rate = 48000;
+static boolean sfx_muted;
+boolean oal_use_doppler, auto_gain;
+
+// These match the level of the engine Wadsmith used before Woof at volume 8.
+#define SFX_LEVEL   0.671f
+#define MUSIC_LEVEL 0.661f
+
+#define LIMITER_CEILING 0.98f
+#define LIMITER_LOOKAHEAD_MS 2
+#define LIMITER_RELEASE_MS 100
+#define LIMITER_MAX_FRAMES 256
+
+static float out_left[MAX_BLOCK], out_right[MAX_BLOCK], out_interleaved[MAX_BLOCK * 2];
+static float master_gain, master_target = 1.0f;
+static float last_left, last_right;
+
+static void FadeInOutMono8(byte *data, int size, int freq)
+{
+    const int fadelen = freq * FADETIME / 1000000;
+    if (size < fadelen)
+    {
+        return;
+    }
+    if (data[0] != 128)
+    {
+        for (int i = 0; i < fadelen; i++)
+        {
+            data[i] = (data[i] - 128) * i / fadelen + 128;
+        }
+    }
+    if (data[size - 1] != 128)
+    {
+        for (int i = 0; i < fadelen; i++)
+        {
+            data[size - 1 - i] = (data[size - 1 - i] - 128) * i / fadelen + 128;
+        }
+    }
+}
+
+boolean I_OAL_InitSound(int snd_module)
+{
+    (void)snd_module;
+    return true;
+}
+boolean I_OAL_ReinitSound(int snd_module)
+{
