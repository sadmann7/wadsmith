+// Mixes sound effects and OPL music into the stereo stream the page plays.
+
+#include <emscripten.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "i_oalsound.h"
+#include "i_oalstream.h"
