+// Players whose commands for the oldest tic are missing while someone else's
+// arrived, as a bitmask of player slots.
+int NW_SV_LaggingPlayers(void)
+{
+    int missing = 0;
+    boolean any_received = false;
+
+    if (!server_initialized || server_state != SERVER_IN_GAME)
+    {
+        return 0;
+    }
+
+    for (int i = 0; i < NW_MAXPLAYERS; ++i)
+    {
+        if (sv_players[i] == NULL || !ClientConnected(sv_players[i]))
+        {
+            continue;
+        }
+
+        if (recvwindow[0][i].active)
+        {
+            any_received = true;
+        }
+        else
+        {
+            missing |= 1 << i;
+        }
+    }
+
+    return any_received ? missing : 0;
+}
