{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "wadsmith-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "MAPS", "class_name": "MapCopy" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["MapCopy"] },
  ],
  // New online maps per address, so one visitor can't fill the storage.
  "ratelimits": [
    {
      "name": "NEW_MAPS",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://wadsmith.com https://www.wadsmith.com https://wadsmith-*-sadmann7s-projects.vercel.app http://localhost:*",
  },
  "observability": { "enabled": true },
}
